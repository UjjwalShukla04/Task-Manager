# --- Server ---
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed browser origins (no trailing slash).
CLIENT_URL=http://localhost:5173

# --- Database ---
# Local dev via docker-compose (see docker-compose.yml at repo root):
DATABASE_URL="postgresql://taskflow:taskflow@localhost:5433/taskflow?schema=public"

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string-min-32-chars"
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# --- Observability (optional) ---
# Leave empty to disable Sentry.
SENTRY_DSN=
LOG_LEVEL=info
